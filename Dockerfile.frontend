FROM node:22-alpine AS builder

WORKDIR /app

# Copiar package files del frontend
COPY frontend/package.json frontend/package-lock.json* ./

# Instalar dependencias
RUN npm install

# Copiar código fuente del frontend
COPY frontend/ .

# Argumento para la URL del API
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build - usar vite directamente (sin tsc)
RUN npx vite build

# Servir con Nginx (Servidor estático de alto rendimiento, nativo para Traefik)
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# Redirigir el tráfico para React Router (SPA)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
